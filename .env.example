# Copy to .env on the box and fill in. NEVER commit the real file.
#
# The internal area is dark unless all three INTERNAL_* values are set: a
# missing or blank value means there is no account at all, rather than a
# weaker one. INTERNAL_SESSION_SECRET must be at least 32 characters or the
# area stays dark.
#
# Generate the password hash on a machine with the app checked out:
#   node scripts/hash-password.mjs
# The hash is colon-separated on purpose -- docker compose performs shell-style
# `$` expansion on env values, and a `$`-separated hash silently collapses to
# "scrypt", after which every login fails with nothing in the logs.
INTERNAL_EMAIL=
INTERNAL_PASSWORD_HASH=
INTERNAL_SESSION_SECRET=

# Optional. With no key the market-data panel does not render at all.
ALPHAVANTAGE_API_KEY=

# codeknight feature flag: set to exactly "true" to publish the writing section.
WRITING_ENABLED=

# Image tags, set by the deploy workflow.
CODEKNIGHT_TAG=latest
NES_TAG=latest
